SCRAPER_USERNAME=
SCRAPER_PASSWORD=
PROXY_LIST=

# Agente LLM (ítem 11 — security_scraping_agent)
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=120

# OSINT opcional (fase 5c) — el catálogo usa fuentes públicas sin API por defecto
HUNTER_API_KEY=

# Nessus / OpenVAS (fase 5e — solo documentación; export manual, ver docs/integraciones-externas-5e.md)
NESSUS_URL=
NESSUS_ACCESS_KEY=

# Docker Compose (ítem 13) — exec en contenedor Kali
KALI_CONTAINER=kali-tools
DOCKER_BIN=docker

# Administración remota SSH (fase 7 — ver docs/alcance-seguridad.md §2.11)
# Solo autenticación por llave (nunca contraseña en texto plano). La llave
# privada va en config/ssh/ (ver config/ssh/README.md), montada solo-lectura
# en el contenedor Kali como /run/secrets/ssh/<archivo>.
SSH_REMOTE_HOST=
SSH_REMOTE_USER=
SSH_REMOTE_KEY_PATH=/run/secrets/ssh/id_ed25519
