  #   authorized_by: "equipo infra"
  #   authorization_date: "2026-07-06"
  #   evidence: "inventario de activos propios"
  #   expires_at: null
  #   allowed_categories:
  #     - passive_recon
  #     - light_active_scan
  #     - active_scanning
  #     - known_vuln_scanning
  #     - bounded_fuzzing
